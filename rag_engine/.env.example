# ---- API keys ----
# Required only for OpenAI embeddings / chat generation / LLM-as-judge verification.
OPENAI_API_KEY=

# ---- Embeddings ----
# openai  -> text-embedding-3-small (needs OPENAI_API_KEY)
# huggingface -> sentence-transformers/all-MiniLM-L6-v2 (local, default)
EMBEDDING_PROVIDER=huggingface
HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
OPENAI_CHAT_MODEL=gpt-4o-mini

# ---- Storage ----
VECTOR_STORE_BACKEND=chroma
COLLECTION_NAME=rag_chunks
DATA_DIR=data

# ---- Chunking ----
DEFAULT_CHUNKING_STRATEGY=structure
CHUNK_SIZE=500
CHUNK_OVERLAP=50
SEMANTIC_DISTANCE_THRESHOLD=0.45
DEDUP_SIMILARITY_THRESHOLD=0.95

# ---- Retrieval & fusion ----
DENSE_TOP_K=10
SPARSE_TOP_K=10
CANDIDATE_POOL_SIZE=20
RERANK_TOP_K=5
RRF_K=60
RRF_DENSE_WEIGHT=0.7
RRF_SPARSE_WEIGHT=0.3

# ---- Models ----
CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
NLI_MODEL_NAME=cross-encoder/nli-deberta-v3-small

# ---- Verification ----
VERIFIER_MODE=auto

# ---- Server ----
LOG_LEVEL=INFO
API_PORT=8000
WARM_MODELS=true
