# ---- API keys ----
# Required only for OpenAI embeddings / chat generation / LLM-as-judge verification.
OPENAI_API_KEY=

# ---- Embeddings ----
# openai  -> text-embedding-3-small (needs OPENAI_API_KEY)
# huggingface -> sentence-transformers/all-MiniLM-L6-v2 (local, default)
EMBEDDING_PROVIDER=huggingface
HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
OPENAI_CHAT_MODEL=gpt-4o-mini

# ---- Storage ----
VECTOR_STORE_BACKEND=chroma
COLLECTION_NAME=rag_chunks
DATA_DIR=data

# ---- Chunking ----
DEFAULT_CHUNKING_STRATEGY=structure
CHUNK_SIZE=500
CHUNK_OVERLAP=50
SEMANTIC_DISTANCE_THRESHOLD=0.45
DEDUP_SIMILARITY_THRESHOLD=0.95

# ---- Retrieval & fusion ----
DENSE_TOP_K=10
SPARSE_TOP_K=10
CANDIDATE_POOL_SIZE=20
RERANK_TOP_K=5
RRF_K=60
RRF_DENSE_WEIGHT=0.7
RRF_SPARSE_WEIGHT=0.3

# ---- Models ----
CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
NLI_MODEL_NAME=cross-encoder/nli-deberta-v3-small

# ---- Verification ----
VERIFIER_MODE=auto

# ---- Server ----
LOG_LEVEL=INFO
API_PORT=8000
WARM_MODELS=true

# ---- Security ----
# API_KEY: when set, /v1/ingest, /v1/ask and /v1/evaluate require header `X-API-Key: <value>`.
# Leave unset for local dev; ALWAYS set this before exposing the service beyond localhost.
API_KEY=
# Per-client (by IP) request budget applied to the same three routes, per process.
RATE_LIMIT_PER_MINUTE=30


# ---- Profile ----
# server -> FastAPI service (default; run with `uvicorn app.main:app`)
# local  -> tray daemon that watches folders on this machine (run with
#           `python scripts/run_local_daemon.py`); needs requirements-local.txt too.
#
# PROFILE is the one thing that must be set as a real environment variable (not in
# this file) before the local daemon starts, since it decides whether to load the
# per-OS config.yaml in the first place:
#   macOS:   export PROFILE=local
#   Windows: set PROFILE=local
#
# Everything under "Local mode only" below is normally edited in that config.yaml
# instead (auto-created on first run — see README's "Local mode" section for its
# path per OS) — these env vars still work as overrides/fallbacks, mainly useful for
# CI or a quick one-off run without touching the YAML file.
PROFILE=server

# ---- Local mode only (normally set via config.yaml instead — see above) ----
# Comma-separated absolute paths to watch and keep indexed.
WATCHED_PATHS=
# Comma-separated directory/file-name or glob patterns to skip while scanning.
EXCLUDED_PATTERNS=
# Skip any file larger than this, regardless of extension.
MAX_INDEX_FILE_SIZE_MB=25
# auto | cpu | cuda | mps — auto picks mps on Apple Silicon, cuda if available, else cpu.
LOCAL_DEVICE=auto
# Results shown per query in the tray search window.
LOCAL_TOP_K=8
# Seconds to coalesce rapid-fire filesystem events (e.g. editor autosave) before re-indexing.
LOCAL_DEBOUNCE_SECONDS=1.5

# ---- Local mode generation ----
# ollama -> local model via Ollama (default when PROFILE=local and no OPENAI_API_KEY)
# openai -> used automatically instead if OPENAI_API_KEY is set
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_CHAT_MODEL=qwen2.5:7b
